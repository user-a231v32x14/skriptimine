#!bin/bash

echo "Sisesta aeg:"
read aeg

if (( aeg >= 6 && aeg < 12 ))
then
    echo "Tere hommiku"
elif (( aeg >= 12 && aeg < 18 ))
then
    echo "Tere paeva"
elif (( aeg >= 18 && aeg < 22 ))
then
    echo " Tere ohtu"
elif (( aeg >= 22 && aeg <= 23 || aeg >= 0 && aeg < 6 ))
then
    echo "Head ood"
else
    echo "Ajataju katki"
fi
